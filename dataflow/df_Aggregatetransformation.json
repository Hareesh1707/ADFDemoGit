{
	"name": "df_Aggregatetransformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_InputEmployee",
						"type": "DatasetReference"
					},
					"name": "EmployeeData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_OutputEmpDeptMerge",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "DeptwiseEmpCount"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EMPLOYEE_ID as string,",
				"          FIRST_NAME as string,",
				"          LAST_NAME as string,",
				"          EMAIL as string,",
				"          PHONE_NUMBER as string,",
				"          HIRE_DATE as string,",
				"          JOB_ID as string,",
				"          SALARY as string,",
				"          COMMISSION_PCT as string,",
				"          MANAGER_ID as string,",
				"          DEPARTMENT_ID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> EmployeeData",
				"EmployeeData aggregate(groupBy(DEPARTMENT_ID),",
				"     {Total Employees} = count(EMPLOYEE_ID)) ~> DeptwiseEmpCount",
				"DeptwiseEmpCount sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Deptwiseempcount.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          {Dept ID} = DEPARTMENT_ID,",
				"          {Total Employees}",
				"     ),",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}