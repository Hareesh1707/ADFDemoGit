{
	"name": "df_conditionalsplittransformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_InputEmployee",
						"type": "DatasetReference"
					},
					"name": "empdata"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_OutputEmpDeptMerge",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "DS_OutputEmpDeptMerge",
						"type": "DatasetReference"
					},
					"name": "sink2"
				},
				{
					"dataset": {
						"referenceName": "DS_OutputEmpDeptMerge",
						"type": "DatasetReference"
					},
					"name": "sink3"
				},
				{
					"dataset": {
						"referenceName": "DS_OutputEmpDeptMerge",
						"type": "DatasetReference"
					},
					"name": "sink4"
				}
			],
			"transformations": [
				{
					"name": "Conditionalsplit"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EMPLOYEE_ID as string,",
				"          FIRST_NAME as string,",
				"          LAST_NAME as string,",
				"          EMAIL as string,",
				"          PHONE_NUMBER as string,",
				"          HIRE_DATE as string,",
				"          JOB_ID as string,",
				"          SALARY as string,",
				"          COMMISSION_PCT as string,",
				"          MANAGER_ID as string,",
				"          DEPARTMENT_ID as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> empdata",
				"empdata split(equals(DEPARTMENT_ID, '40'),",
				"     equals(DEPARTMENT_ID, '60'),",
				"     equals(DEPARTMENT_ID, '20'),",
				"     disjoint: false) ~> Conditionalsplit@(HumanResources, IT, Marketing, Others)",
				"Conditionalsplit@HumanResources sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['HumanResources.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink1",
				"Conditionalsplit@IT sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['IT.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink2",
				"Conditionalsplit@Marketing sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['Marketing.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink3",
				"Conditionalsplit@Others sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['OtherDepartments.csv'],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     partitionBy('hash', 1)) ~> sink4"
			]
		}
	}
}