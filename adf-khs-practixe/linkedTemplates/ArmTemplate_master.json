{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-khs-practixe"
		},
		"Azure_SQLDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Azure_SQLDB'"
		},
		"IRselfhostedCIT_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'IRselfhostedCIT'"
		},
		"LS_SQLserverCIT_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLserverCIT'"
		},
		"ls_azureblobstorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_azureblobstorage'"
		},
		"Azure_SQLDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adfpracticekhs.database.windows.net"
		},
		"Azure_SQLDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdfPractice"
		},
		"Azure_SQLDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Hareesh.K"
		},
		"IRselfhostedCIT_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "CIT-LP284"
		},
		"IRselfhostedCIT_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2019"
		},
		"IRselfhostedCIT_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CIT\\Hareesh.K"
		},
		"LS_SQLserverCIT_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "CIT-LP284"
		},
		"LS_SQLserverCIT_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksLT2019"
		},
		"LS_SQLserverCIT_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CIT\\Hareesh.K"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
