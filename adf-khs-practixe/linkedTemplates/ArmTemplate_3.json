		{
			"name": "[concat(parameters('factoryName'), '/PL_lookupActivity_firstrow')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup1",
